# Copy to .env and fill in. Never commit the real .env.

# Signs/verifies L402 macaroons. Generate once with: openssl rand -hex 32
# Changing it invalidates every previously issued macaroon.
ROOT_KEY=change-me-generate-with-openssl-rand-hex-32

# LNURL / Lightning-address mode: no node to run on the host. Payments land in
# whatever wallet backs this address (Alby, your own LNURL server, etc.).
LNURL_ADDRESS=you@your-lightning-address.com

# Domain this server is reachable at. Its A record must point at this host.
# Used for TLS (certbot) and the nginx config.
DOMAIN=blossom.ngx-l402.org

# Email for Let's Encrypt expiry notices.
CERTBOT_EMAIL=you@example.com

# Reminder: also set DOMAIN (publicDomain) and your publisher pubkey (hex) in
# blossom-config.yml.

# --- Cashu ecash (optional) --------------------------------------------------
# Accept ecash alongside Lightning. The paywall then also returns an X-Cashu
# (NUT-24) payment request on its 402, so clients can pay in ecash or Lightning.
# Leave CASHU_ECASH_SUPPORT empty/unset to stay L402-only.

# Turn ecash on.
CASHU_ECASH_SUPPORT=true

# Mints whose tokens are accepted, comma-separated. REQUIRED for Cashu: with no
# whitelist the server cannot advertise a challenge, since accepting an arbitrary
# mint would let a forged mint pay. Defaults are the Minibits and Coinos mints.
CASHU_WHITELISTED_MINTS=https://mint.minibits.cash/Bitcoin,https://mint.coinos.io

# The server's own ecash wallet seed (BIP39, 12 words); it receives the tokens.
# Back it up: it controls the received funds. Left unset, the module generates and
# persists one to the cashu volume, but pin it here so it is stable across images.
CASHU_WALLET_MNEMONIC=

# Tokens are always received into the server's Cashu wallet (that grants access);
# this only controls whether the held ecash is then melted to your configured
# Lightning backend. Set false to keep it as ecash, e.g. with a test mint that
# can't be melted.
CASHU_REDEEM_ON_LIGHTNING=true
